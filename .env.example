# ============================================================
# DevTrack environment template — copy to .env and fill in.
# ============================================================

# Production builds should set this BEFORE starting the server.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Which config to load: development | testing | production
CONFIG=development

# Port the dev server listens on (4800+ avoids clashing with other tools)
PORT=5001

# Optional: override where the SQLite file lives (default: ./instance/devtrack.db)
# DATABASE=instance/devtrack.db

# Public URL used for absolute links inside emails
# APP_URL=http://127.0.0.1:5001

# ---- Email (SMTP) — used by the password-reset flow ----
# Leave SMTP_HOST empty to disable real delivery (reset links are logged
# to the server log instead, handy for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional: address shown in the From header. Defaults to SMTP_USERNAME.
# SMTP_MAIL_FROM=
# 1 = STARTTLS on SMTP_PORT, 0 = plain. Set SMTP_USE_SSL=1 for implicit TLS (465).
SMTP_USE_TLS=1
SMTP_USE_SSL=0
# Optional: the matching newly registered account receives the platform owner
# role. Set this before registration; leave blank to create members only.
BOOTSTRAP_OWNER_EMAIL=
